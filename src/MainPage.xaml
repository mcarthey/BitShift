<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="BitShift.MainPage"
             BackgroundColor="#FAF8EF">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        
        <!-- Header with Score -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,20,0,30">
            <StackLayout VerticalOptions="Center">
                <Label Text="BitShift" FontSize="40" FontAttributes="Bold" TextColor="#776E65"/>
                <Label Text="Swipe to merge, tap to select, shift to transform" FontSize="12" TextColor="#9E9E9E"/>
            </StackLayout>
            
            <Frame Grid.Column="1" 
                   BackgroundColor="#BBADA0" 
                   CornerRadius="5" 
                   Padding="20,10"
                   HasShadow="False">
                <StackLayout>
                    <Label Text="SCORE" FontSize="12" TextColor="#EEE4DA" HorizontalOptions="Center"/>
                    <Label x:Name="ScoreLabel" Text="0" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>
        </Grid>

        <!-- Game Board -->
        <Frame Grid.Row="1" 
               BackgroundColor="#BBADA0" 
               CornerRadius="10" 
               Padding="10"
               HasShadow="True">
            <skia:SKCanvasView x:Name="GameCanvas" 
                              PaintSurface="OnCanvasViewPaintSurface"
                              EnableTouchEvents="True"
                              Touch="OnCanvasViewTouch"/>
        </Frame>

        <!-- Controls -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,20,0,0">
            <Button Grid.Column="0"
                    Text="New Game"
                    BackgroundColor="#8F7A66"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="5"
                    Clicked="OnNewGameClicked"/>

            <Button Grid.Column="1"
                    x:Name="LeftShiftButton"
                    Text="&lt;&lt; x2"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="5"
                    Clicked="OnLeftShiftClicked"
                    IsEnabled="False"/>

            <Button Grid.Column="2"
                    x:Name="RightShiftButton"
                    Text=">> /2"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="5"
                    Clicked="OnRightShiftClicked"
                    IsEnabled="False"/>
        </Grid>

    </Grid>

</ContentPage>
